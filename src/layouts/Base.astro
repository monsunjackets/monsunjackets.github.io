---
// Page shell: head metadata, fonts, tokens, header and footer (ADR 0001 §4, §7).
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site.ts';
// Astro renders the CSP meta, styles and scripts where the head is rendered, by default just before </head>,
// after every link above it. Rendering it right after the viewport meta puts the CSP meta before every link
// and script in <head> (verify-dist rule csp-position). Internal Astro API; verify-dist fails if it stops working.
import { renderHead } from 'astro/runtime/server/index.js';

export interface Props {
  /** Page title without the brand suffix. */
  title: string;
  /** Meta description, at most 160 characters. */
  description: string;
  /** Link-preview image (1200×630), path from the site root. */
  image?: string;
  /** JSON-LD objects for this page, serialised with the A2 helpers once they land. */
  jsonLd?: object[];
}
const { title, description, image = '/og-default.png', jsonLd = [] } = Astro.props;
const ld = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | MONSUN`;
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {renderHead()}
  <meta name="color-scheme" content="light dark">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MONSUN">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="MONSUN: Odzież na lata, nie na sezony.">
  <meta name="twitter:card" content="summary_large_image">
  {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification}>}
  {jsonLd.map((data) => <script type="application/ld+json" set:html={ld(data)} />)}
  <!-- consent module placement point (B2) -->
  <slot name="head" />
  <link rel="preload" href="/fonts/AnekLatin-VF.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
