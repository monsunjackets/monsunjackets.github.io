---
// Blog index (ADR 0001 §2, §3). It also enforces "one published post per team member, each with its own keyword"
// (lecture slides 7–8): assertUniquePosts fails the build otherwise. Drafts are listed in dev only.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/editorial/Avatar.astro';
import Breadcrumbs from '../../components/editorial/Breadcrumbs.astro';
import PostTeaser from '../../components/editorial/PostTeaser.astro';
import { listedPosts } from '../../components/editorial/content.ts';
import { assertUniquePosts } from '../../lib/blog-checks.ts';
import { breadcrumbListJsonLd } from '../../lib/schema.ts';

assertUniquePosts(await getCollection('posts'));
const posts = await listedPosts();
const authors = (await getCollection('authors')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'pl'));

const crumbs = [
  { name: 'MONSUN', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---
<Base
  title="Blog o kurtkach skórzanych: zima, rozmiary, pielęgnacja"
  description="Jak nosić skórzaną kurtkę zimą, jak dobrać rozmiar przy zakupie online i jak o nią dbać. Każdy wpis ma autora z zespołu, własne zdjęcie i opis użycia AI."
  jsonLd={[breadcrumbListJsonLd(crumbs)]}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <header class="section-head intro">
      <h1>Blog o kurtkach skórzanych</h1>
      <p class="lede">Piszemy, jak nosić skórzaną kurtkę zimą, jak dobrać rozmiar, gdy kupujesz online, i jak o nią dbać. Każdy wpis ma autora z zespołu, własne zdjęcie i informację, jak pomogło AI.</p>
    </header>

    {posts.length > 0 ? (
      <div class="posts">
        {posts.map((post) => <PostTeaser post={post} />)}
      </div>
    ) : (
      <p class="empty reading">Pierwsze wpisy pojawią się wkrótce.</p>
    )}

    <section class="authors" aria-labelledby="autorzy">
      <h2 id="autorzy">Autorzy</h2>
      <ul>
        {authors.map((author) => (
          <li>
            <Avatar author={author} />
            <span>
              <a href={`/autorzy/${author.id}/`}>{author.data.name}</a>
              <small>{author.data.role}</small>
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .intro { padding-top: 1.25rem; margin-bottom: 2.5rem; }
  .intro h1 { font-size: clamp(2.4rem, 5.5vw, 4rem); font-stretch: 80%; font-weight: 720; line-height: 1; letter-spacing: -.01em; }
  .posts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2.5rem); }
  .empty { padding: 1.25rem 0; border-top: 2px solid var(--ink); font-size: var(--step-1); max-width: 60ch; }
  .authors { padding-block: clamp(3rem, 7vw, 5rem); }
  .authors h2 { font-size: var(--step-3); font-stretch: 85%; font-weight: 700; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 2rem; }
  li { display: flex; align-items: center; gap: .8rem; }
  li span { display: grid; }
  li a { color: var(--ink); font-weight: 600; }
  small { color: var(--ink-soft); font-size: var(--step--1); }
  @media (max-width: 860px) {
    .posts, ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
