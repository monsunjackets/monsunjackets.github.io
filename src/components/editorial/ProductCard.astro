---
// Link from a post to its product (lecture slide 7, element 5). The thumbnail wrapper carries data-vt-product,
// the page-transitions hook (one per product per page); with no product image yet it shows an empty slot.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { productPath } from '../shop/content.ts';
import { AI_LABEL, formatPln } from '../shop/format.ts';

export interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const { name, plannedPrice, images } = product.data;
const image = images[0];
---
<a class="product-card" href={productPath(product)}>
  <span class="thumb" data-vt-product={product.id}>
    {image ? (
      <Image src={image.src} alt="" width={96} height={120} densities={[1, 2]} fit="cover" />
    ) : (
      <span class="slot" aria-hidden="true">Zdjęcie wkrótce</span>
    )}
  </span>
  <span class="text">
    <strong>{name}</strong>
    <span>Planowana cena premierowa: {formatPln(plannedPrice.pln)}. {plannedPrice.note}</span>
    <span class="more">Zobacz model i tabelę rozmiarów</span>
    {image?.ai && <span class="ai">{AI_LABEL}</span>}
  </span>
</a>

<style>
  .product-card { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 1rem; align-items: center; padding: .75rem;
    border-radius: var(--r-media); background: var(--raised); box-shadow: inset 0 0 0 1px var(--line); color: inherit; text-decoration: none; }
  .product-card:hover { box-shadow: inset 0 0 0 1.5px var(--petrol); }
  .thumb { display: block; width: 96px; height: 120px; border-radius: 8px; overflow: hidden; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .slot { display: grid; place-items: center; height: 100%; padding: .4rem; text-align: center; font-size: var(--step--1); color: var(--ink-soft);
    background: var(--sunk); background-image: repeating-linear-gradient(45deg, transparent 0 9px, var(--line) 9px 10px); }
  .text { display: grid; gap: .2rem; font-size: var(--step--1); color: var(--ink-soft); }
  strong { color: var(--ink); font-size: var(--step-1); font-stretch: 90%; font-weight: 650; line-height: 1.15; }
  .more { color: var(--petrol); font-weight: 600; text-decoration: underline; text-underline-offset: .18em; }
  .ai { font-size: .75rem; }
</style>
