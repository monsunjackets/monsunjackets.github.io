---
// Visible breadcrumbs. Pages pass the same list to breadcrumbListJsonLd(), so the trail and the JSON-LD agree.
import type { BreadcrumbInput } from '../../lib/schema.ts';

export interface Props {
  /** From the home page to the current page; the last item is the current page and is not a link. */
  items: readonly BreadcrumbInput[];
}
const { items } = Astro.props;
const last = items.length - 1;
---
<nav class="crumbs" aria-label="Ścieżka nawigacji">
  <ol>
    {items.map((item, i) => (
      <li>{i === last ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { font-size: var(--step--1); color: var(--ink-soft); padding-top: 1.5rem; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem; min-width: 0; }
  li { display: flex; gap: .3rem; min-width: 0; }
  /* The separator is decoration: the empty alt text keeps screen readers from reading it, where supported. */
  li + li::before { content: "/"; content: "/" / ""; }
  a { color: var(--ink-soft); }
  [aria-current] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 40ch; }
</style>
