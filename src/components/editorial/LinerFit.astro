---
// Which models come with the liner and which take it (ADR 0001 §2: /podpinka/ covers compatibility). Rows come
// from the products collection, so the table grows with the catalogue. The wording matches the home page.
import { productsInOrder } from './content.ts';

const LINER = {
  included: 'Podpinka w zestawie',
  compatible: 'Będzie pasować każda podpinka MONSUN w tym samym rozmiarze',
  liner: 'Do wszystkich kurtek MONSUN',
} as const;
const products = await productsInOrder();
---
{products.length > 0 && (
  <section class="fit" aria-labelledby="pasuje">
    <h2 id="pasuje">Do których kurtek pasuje podpinka</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Model</th><th scope="col">Podpinka</th></tr></thead>
        <tbody>
          {products.map((product) => (
            <tr><th scope="row">{product.data.name}</th><td>{LINER[product.data.liner]}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<style>
  .fit { display: grid; gap: 1rem; }
  h2 { font-size: var(--step-3); font-stretch: 85%; font-weight: 700; line-height: 1.08; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .95rem; }
  th, td { text-align: left; padding: .6rem .8rem .6rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { font-weight: 600; color: var(--ink-soft); font-size: var(--step--1); }
  tbody th { font-weight: 600; }
  td { color: var(--ink-soft); }
</style>
