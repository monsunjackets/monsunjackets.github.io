---
// Typography for rendered Markdown: post bodies and the content pages. Markdown output has no classes, so the
// rules reach it through :global() under .prose.
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={['prose', className]}><slot /></div>

<style>
  .prose { min-width: 0; }
  .prose > :global(* + *) { margin-top: 1em; }
  .prose :global(h2) { font-size: var(--step-3); font-stretch: 85%; font-weight: 700; line-height: 1.08; letter-spacing: -.005em; }
  .prose :global(h3) { font-size: var(--step-1); font-stretch: 90%; font-weight: 650; line-height: 1.2; }
  .prose > :global(h2:not(:first-child)) { margin-top: 2.2rem; }
  .prose > :global(h3:not(:first-child)) { margin-top: 1.6rem; }
  .prose :global(:is(h2, h3) + *) { margin-top: .6em; }
  .prose :global(:is(p, li, blockquote)) { max-width: 64ch; }
  .prose :global(:is(ul, ol)) { margin-block: 0; padding-left: 1.2rem; }
  .prose :global(li + li) { margin-top: .35rem; }
  .prose :global(li::marker) { color: var(--petrol); }
  .prose :global(strong) { font-weight: 650; }
  .prose :global(blockquote) { margin-inline: 0; padding-left: 1rem; border-left: 2px solid var(--petrol); color: var(--ink-soft); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin-block: 2rem; }
  .prose :global(img) { border-radius: var(--r-media); }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .95rem; }
  .prose :global(:is(th, td)) { text-align: left; padding: .55rem .8rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(thead th) { font-weight: 600; color: var(--ink-soft); font-size: var(--step--1); }
</style>
