---
import Logo from './Logo.astro';
import { site } from '../config/site.ts';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="disclosure">
      <Logo class="footer-logo" quiltId="footer-logo-quilt" />
      <p><strong>Projekt studencki PWr.</strong> MONSUN to marka koncepcyjna przygotowana na zajęcia z marketingu
        cyfrowego. Niczego nie sprzedajemy.</p>
      {site.contactEmail ? <p>Kontakt: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p> : <p>Adres kontaktowy podamy wkrótce.</p>}
    </div>
    <ul aria-label="Na stronie">
      <li><a href="/podpinka/">Jak działa podpinka</a></li>
      <li><a href="/kolekcja/">Kolekcja</a></li>
      <li><a href="/rozmiary/">Rozmiary</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/o-nas/">O nas</a></li>
      <li><a href="/gwarancja/">Gwarancja i zwroty</a></li>
      <li><a href="/prywatnosc/">Prywatność</a></li>
    </ul>
    <div class="privacy">
      {site.ga4Id === null ? (
        <p class="note">Strona nie używa plików cookie ani narzędzi analitycznych.</p>
      ) : (
        <button type="button" class="link" data-consent-open hidden>Zmień zgodę na cookies</button>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--sunk); }
  .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 3fr); gap: 2rem; padding-block: 3rem; font-size: .95rem; }
  .disclosure { display: grid; gap: .8rem; color: var(--ink-soft); }
  .disclosure strong { color: var(--ink); }
  .disclosure :global(svg) { height: 1.1rem; width: auto; aspect-ratio: 9757.7 / 1687; color: var(--ink); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; align-content: start; }
  a { color: var(--ink); }
  .privacy { display: grid; gap: .4rem; align-content: start; justify-items: start; }
  .link { font: inherit; color: var(--ink); background: none; border: 0; padding: 0; cursor: pointer; text-align: start;
    text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 1px; }
  .link:hover { text-decoration-thickness: 2px; }
  @media (max-width: 860px) { .wrap { grid-template-columns: minmax(0, 1fr); } }
</style>
