---
import Logo from './Logo.astro';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="MONSUN, strona główna"><Logo class="brand-logo" quiltId="header-logo-quilt" /></a>
    <nav class="site-nav" aria-label="Główna">
      <a href="/#sposoby">Jak działa podpinka</a>
      <a href="/#kolekcja">Kolekcja</a>
      <a href="/#pochodzenie">O nas</a>
    </nav>
    <a class="btn small" href="/#lista">Lista startowa</a>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 5; background: var(--header-bg); border-bottom: 1px solid var(--line); }
  .wrap { display: flex; align-items: center; gap: 1.25rem; padding-block: .75rem; flex-wrap: wrap; }
  .brand { display: inline-flex; color: var(--ink); }
  .brand :global(svg) { height: 1.15rem; width: auto; aspect-ratio: 9757.7 / 1687; display: block; }
  .site-nav { display: flex; gap: 1.1rem; flex-wrap: wrap; margin-right: auto; }
  .site-nav a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .site-nav a:hover { color: var(--petrol); }
  @media (max-width: 860px) { .site-nav { order: 3; width: 100%; } }
</style>
