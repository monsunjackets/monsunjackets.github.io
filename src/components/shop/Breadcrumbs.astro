---
// Visible breadcrumbs. The page passes the same items to breadcrumbListJsonLd, so the two cannot disagree.
import type { BreadcrumbInput } from '../../lib/schema.ts';

export interface Props {
  /** From the home page down to this page; the last item is the current page and is not a link. */
  items: readonly BreadcrumbInput[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Ścieżka">
  <ol>
    {items.map((item, index) => (
      <li>{index < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { font-size: var(--step--1); color: var(--ink-soft); padding-top: 1.5rem; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem .5rem; }
  /* The separator is decoration: the empty alt text keeps screen readers from reading it. */
  li + li::before { content: "/"; content: "/" / ""; margin-right: .5rem; color: var(--ink-soft); }
  a { color: var(--ink-soft); }
  a:hover { color: var(--ink); }
</style>
