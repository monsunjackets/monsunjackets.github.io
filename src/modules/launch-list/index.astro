---
// launch-list (ADR 0001 §5, plan 0002 B3): the #lista section. Place it once per page; the page passes `source`.
// With site.form null it shows the "opens soon" state with no inputs. With a form configured it renders the form
// that posts straight to Google Forms (mode 'post') or a link to the Form (mode 'link'), with the privacy summary.
// Settings come from src/config/site.ts and are checked at build time; see README.md.
import { site } from '../../config/site.ts';
import LaunchListView from './LaunchListView.astro';

export interface Props {
  /** Where the sign-up happened; sent as the form's `zrodlo` field, e.g. 'home' or 'podpinka'. */
  source: string;
  class?: string;
}
const { source, class: className } = Astro.props;
---
<LaunchListView
  source={source}
  class={className}
  form={site.form}
  contactEmail={site.contactEmail}
  deleteBy={site.launchList.deleteBy}
/>
