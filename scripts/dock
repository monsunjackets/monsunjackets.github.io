#!/usr/bin/env bash
# Runs npm, npx, node or astro in a throwaway Node container. This host also holds unrelated work
# credentials, so code from npm packages never runs on it (ADR 0001 §1, amended after reviews G1 and G1b).
#
# Dev, build, test and check see the checkout read-only; only the output folders (node_modules, dist,
# .astro, .npm-cache) are writable, so package code cannot change anything the host later runs or reads
# as configuration (git repos and hooks, scripts/, Claude or editor settings). npm ci/install get a
# writable checkout because they run npm's own code only: .npmrc has ignore-scripts=true. DOCK_RW=1
# forces a writable checkout for our own scripts that edit sources (images:strip).
#
# Usage: scripts/dock npm ci | PORT=4321 scripts/dock npm run dev | scripts/dock npm run build
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="node:24-bookworm-slim@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530"
tty=(); if [ -t 0 ] && [ -t 1 ]; then tty=(-t); fi
ports=(); if [ -n "${PORT:-}" ]; then ports=(-p "127.0.0.1:${PORT}:${PORT}"); fi

writable=0
if [ "${DOCK_RW:-}" = 1 ]; then writable=1; fi
if [ "${1:-}" = npm ] && [[ " ci install i uninstall update " == *" ${2:-} "* ]]; then writable=1; fi

mounts=()
if [ "$writable" = 1 ]; then
  mounts+=(--mount "type=bind,src=${ROOT},dst=/work")
else
  mounts+=(--mount "type=bind,src=${ROOT},dst=/work,readonly")
  for dir in node_modules dist .astro .npm-cache; do
    mkdir -p "${ROOT}/${dir}"
    mounts+=(--mount "type=bind,src=${ROOT}/${dir},dst=/work/${dir}")
  done
fi
mkdir -p "${ROOT}/.claude"
mounts+=(--mount "type=bind,src=${ROOT}/scripts,dst=/work/scripts,readonly"
         --mount "type=bind,src=${ROOT}/.claude,dst=/work/.claude,readonly")
if [ -e "${ROOT}/.git" ]; then mounts+=(--mount "type=bind,src=${ROOT}/.git,dst=/work/.git,readonly"); fi

status=0
docker run --rm -i "${tty[@]}" --init \
  --user "$(id -u):$(id -g)" --cap-drop=ALL --security-opt=no-new-privileges \
  "${mounts[@]}" -w /work \
  -e HOME=/tmp -e npm_config_cache=/work/.npm-cache -e ASTRO_TELEMETRY_DISABLED=1 \
  -e PORT="${PORT:-}" -e MONSUN_LAB="${MONSUN_LAB:-}" \
  "${ports[@]}" "$IMAGE" "$@" || status=$?

# The output folders stay writable, so they must never hold files that git, an editor or a Claude
# session would act on when someone reads or opens them.
planted="$(find "${ROOT}/dist" "${ROOT}/.astro" \( -name .git -o -name .claude -o -name CLAUDE.md \
  -o -name CLAUDE.local.md -o -name AGENTS.md -o -name .mcp.json -o -name .vscode \) -print 2>/dev/null || true)"
if [ -n "$planted" ]; then
  printf 'scripts/dock: unexpected files in build output; delete them and find out what wrote them:\n%s\n' "$planted" >&2
  exit 97
fi
exit "$status"
