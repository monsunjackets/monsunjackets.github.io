#!/usr/bin/env bash
# Runs npm, npx, node or astro in a throwaway Node container that mounts only this checkout.
# This host also holds unrelated work credentials, so npm code never runs on it (ADR 0001 §1).
# Paths the host executes later (.git, scripts/, .claude/) are mounted read-only, so code inside the
# container cannot plant a git hook, edit this script or add a Claude hook. HOME is thrown away each run.
# Usage: scripts/dock npm ci | PORT=4321 scripts/dock npm run dev | scripts/dock node -v
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="node:24-bookworm-slim@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530"
tty=(); if [ -t 0 ] && [ -t 1 ]; then tty=(-t); fi
ports=(); if [ -n "${PORT:-}" ]; then ports=(-p "127.0.0.1:${PORT}:${PORT}"); fi
mkdir -p "${ROOT}/.claude"
ro=(--mount "type=bind,src=${ROOT}/scripts,dst=/work/scripts,readonly"
    --mount "type=bind,src=${ROOT}/.claude,dst=/work/.claude,readonly")
if [ -e "${ROOT}/.git" ]; then ro+=(--mount "type=bind,src=${ROOT}/.git,dst=/work/.git,readonly"); fi
exec docker run --rm -i "${tty[@]}" --init \
  --user "$(id -u):$(id -g)" --cap-drop=ALL --security-opt=no-new-privileges \
  -v "${ROOT}:/work" "${ro[@]}" -w /work \
  -e HOME=/tmp -e npm_config_cache=/work/.npm-cache -e ASTRO_TELEMETRY_DISABLED=1 \
  -e PORT="${PORT:-}" -e MONSUN_LAB="${MONSUN_LAB:-}" \
  "${ports[@]}" "$IMAGE" "$@"
