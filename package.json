{
  "name": "monsunjackets.github.io",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port ${PORT:-4321} --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port ${PORT:-4321}",
    "check": "astro sync && tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" \"src/**/*.test.ts\"",
    "verify": "node scripts/verify-dist.ts",
    "images:check": "node scripts/check-images.ts"
  },
  "dependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
